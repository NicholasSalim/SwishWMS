# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/postgres"

# Auth.js (NextAuth)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Supabase Storage (S3-compatible) - optional, free tier
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-service-role-key"
SUPABASE_BUCKET="swishwms-attachments"

# App
NEXT_PUBLIC_APP_NAME="SwishWMS"
NEXT_PUBLIC_DEFAULT_LOCALE="id"
NEXT_PUBLIC_DEFAULT_TIMEZONE="Asia/Jakarta"
NEXT_PUBLIC_DEFAULT_CURRENCY="IDR"
